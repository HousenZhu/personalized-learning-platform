# Used by native development. Docker Compose supplies its own internal database URL.
DATABASE_URL="postgresql://postgres:password@localhost:5432/learning_platform?schema=public"

# Better Auth
BETTER_AUTH_SECRET="your-super-secret-key-change-in-production"
BETTER_AUTH_URL="http://localhost:3000"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# CoursePilot Python Agent
AGENT_SERVICE_URL="http://localhost:8000"
# Generate a separate random value of at least 32 characters.
AGENT_INTERNAL_SECRET="replace-with-at-least-32-random-characters"
AGENT_JWT_ISSUER="learnhub-web"
AGENT_JWT_AUDIENCE="coursepilot-agent"
# Local Ollama, accessed from the Agent container through Docker Desktop.
LLM_API_KEY="ollama"
LLM_BASE_URL="http://host.docker.internal:11434/v1"
LLM_MODEL="qwen3:4b"

# Optional DashScope alternative:
# LLM_API_KEY="your-dashscope-api-key"
# LLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
# LLM_MODEL="qwen-turbo"


# AWS S3 File Storage (Cloud)
# Uncomment and fill in your AWS credentials to use S3 for file storage
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=your-bucket-name
# AWS_S3_REGION=us-east-1
